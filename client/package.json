{
  "name": "portable-agent-client",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/cli",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "test:live": "vitest run -c vitest.live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
