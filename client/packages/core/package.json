{
  "name": "@pa/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./src/index.ts", "default": "./dist/index.js" },
    "./contract": { "source": "./src/contract/index.ts", "types": "./src/contract/index.ts", "default": "./dist/contract/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  }
}
