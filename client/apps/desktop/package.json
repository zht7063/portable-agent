{
  "name": "@pa/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --conditions=source --main-fields=module,main --outfile=dist/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --conditions=source --main-fields=module,main --outfile=dist/preload/index.cjs && esbuild ../../packages/key-helper/src/main.ts --bundle --platform=node --format=cjs --external:@napi-rs/keyring --conditions=source --main-fields=module,main --outfile=dist/key-helper/pa-key.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "stage": "node scripts/stage.mjs",
    "pack:dir": "npm run build && node scripts/stage.mjs && electron-builder --dir --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@pa/core": "0.0.0",
    "@pa/key-helper": "0.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11"
  }
}
