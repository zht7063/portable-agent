{
  "name": "@pa/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --conditions=source --outfile=dist/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --conditions=source --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@pa/core": "0.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "vite": "^5.4.11"
  }
}
